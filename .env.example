# ========================================================================
# InsightFlow — Build Battle 2026 Environment Configuration Example
# ========================================================================

# --- Application Runtime & Network ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# --- Database & Authentication (Supabase PostgreSQL) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional direct connection string for PostgreSQL migrations & pool
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# --- Core Requirement 2: Adaption Labs Integration ---
ADAPTION_API_KEY=your-adaption-api-key
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
ADAPTION_MOCK=false

# --- Core Requirement 2, 4 & Chat: AI Engine ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
