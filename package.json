{
  "name": "insightflow",
  "version": "1.0.0",
  "description": "InsightFlow - Build Battle 2026 Hackathon Project",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,cyan\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "db:migrate": "npm run db:migrate --prefix server",
    "seed": "npm run seed --prefix server",
    "seed:sample": "npm run seed:sample --prefix server",
    "seed:clean": "npm run seed:clean --prefix server",
    "test": "npm run test --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
